# Vercel Container Runtime (Beta) — runs this Spring Boot app as an OCI container Function.
# Vercel sets $PORT (default 80); application.yaml reads it via server.port: ${PORT:${SERVER_PORT:8087}}.
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
COPY .mvn .mvn
COPY mvnw .
RUN chmod +x mvnw && ./mvnw -q -DskipTests dependency:go-offline || true
COPY src src
RUN ./mvnw -q -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/target/afrismart-0.0.1-SNAPSHOT.jar app.jar
# Headless avoids AWT crashes when compressing uploaded images on the server.
ENV JAVA_TOOL_OPTIONS="-Djava.awt.headless=true"
# File H2 so several people can sign in and demo on the same warm instance (survives requests until scale-to-zero).
ENV AFRISMART_DB_URL="jdbc:h2:file:/tmp/afrismart-data/afrismart;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH;DB_CLOSE_ON_EXIT=FALSE"
ENTRYPOINT ["java", "-jar", "app.jar"]
