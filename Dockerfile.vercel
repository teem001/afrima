# Vercel Container — Node AfriSmart API (WebSocket + media HTTP) on PostgreSQL.
#
# Required env (Vercel → Environment Variables):
#   AFRISMART_DB_URL=jdbc:postgresql://HOST:5432/DB?sslmode=require
#     (or postgresql://USER:PASS@HOST:5432/DB?sslmode=require)
#   AFRISMART_DB_USER=...          # if not embedded in URL
#   AFRISMART_DB_PASSWORD=...
#   AFRISMART_JWT_SECRET=...       # long random string
# Optional:
#   AFRISMART_DB_POOL_SIZE=5
#   AFRISMART_DEMO_SEED=false
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY server/package.json server/package-lock.json ./
RUN npm ci
COPY server/ ./
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV AFRISMART_DEMO_SEED=false
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/src/db/migrations ./dist/db/migrations
EXPOSE 80
CMD ["node", "dist/index.js"]
