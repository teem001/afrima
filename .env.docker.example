# Inject into Docker / Vercel for the Node backend (never commit real secrets).

AFRISMART_DB_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
AFRISMART_DB_USER=your_db_user
AFRISMART_DB_PASSWORD=your_db_password
AFRISMART_JWT_SECRET=change-me-to-a-long-random-string

# Optional
AFRISMART_DB_POOL_SIZE=5
AFRISMART_DEMO_SEED=false
PORT=80

# URI form also works:
# AFRISMART_DB_URL=postgresql://USER:PASS@HOST:5432/DATABASE?sslmode=require
