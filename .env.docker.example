# Inject these into Docker / Vercel (never commit real secrets).
# Create a Postgres DB (Neon, Supabase, RDS, local Docker), then fill in:

AFRISMART_DB_URL=jdbc:postgresql://ep-xxxx.eu-central-1.aws.neon.tech:5432/neondb?sslmode=require
AFRISMART_DB_USER=neondb_owner
AFRISMART_DB_PASSWORD=your-password-here

# Optional
AFRISMART_DB_POOL_SIZE=5
AFRISMART_JWT_SECRET=change-me-to-a-long-random-string
AFRISMART_DEMO_SEED=false

# If your host gives a URI like postgres://user:pass@host/db?sslmode=require
# convert it to JDBC:
#   postgres://USER:PASS@HOST:5432/DB?sslmode=require
# → jdbc:postgresql://HOST:5432/DB?sslmode=require
# and put USER / PASS in AFRISMART_DB_USER / AFRISMART_DB_PASSWORD
